# Servidor: nunca exponha estas variáveis com prefixo VITE_.
BREVO_API_KEY=
BREVO_LEADS_LIST_ID=24
BREVO_SSL26_ATTRIBUTES_ENABLED=true
BREVO_PROFILE_ATTRIBUTE=SSL26_PROFILE
BREVO_SENDER_EMAIL=geraldo@hotelsolar.tur.br
BREVO_SENDER_NAME=Geraldo | Hotel Solar
BREVO_REPLY_TO_EMAIL=reserva@hotelsolar.tur.br
BREVO_REPLY_TO_NAME=Reservas | Hotel Solar

# URL pública usada nos e-mails transacionais.
PUBLIC_SITE_URL=https://hotelsolar.tur.br/solarsemlimitescadastro
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vb8iEz73gvWjJea5rt3k
VITE_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vb8iEz73gvWjJea5rt3k

# Meta: Pixel (navegador) e Conversions API (servidor).
# O ID do conjunto de dados "Hotel Solar - Site" (743518114034395), do
# portfólio Hotel Solar Salinópolis, já está embutido no código, dos
# dois lados. As duas variáveis abaixo só servem para trocar de Pixel sem mexer
# no código — e, se usadas, precisam receber o MESMO valor: IDs diferentes
# desligam a deduplicação em silêncio e cada lead passa a contar duas vezes.
VITE_META_PIXEL_ID=
META_PIXEL_ID=

# Único valor obrigatório: sem ele a Conversions API não envia nada.
# É segredo, só no servidor, nunca com prefixo VITE_.
META_CAPI_TOKEN=
META_API_VERSION=v21.0
# Só durante a conferência no Gerenciador de Eventos; remover depois.
META_TEST_EVENT_CODE=

# Ponte segura para o ERP: /api/ssl26/ingest. Configurar somente no servidor.
# O receptor deve confirmar { success: true, persisted: true }.
# Token exclusivo de servidor, igual ao SSL26_INGEST_TOKEN do ERP (32+ caracteres).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
